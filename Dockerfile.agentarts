FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    AGENTARTS_BIND_IP=0.0.0.0 \
    PORT=8080
WORKDIR /app
COPY requirements-workflow.txt requirements-agentarts.txt ./
RUN pip install --no-cache-dir -r requirements-agentarts.txt \
    && useradd --create-home app
COPY --chown=app:app . .
RUN mkdir -p runtime data/course_notes && chown -R app:app runtime data/course_notes
USER app
EXPOSE 8080
CMD ["python", "-B", "agentarts_app.py"]
