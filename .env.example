# Optional: the complete URL of a chat-completions-compatible endpoint.
# Leave empty to use the fully offline rules and tutoring workflow.
LABAGENT_LLM_URL=
LABAGENT_LLM_MODEL=
LABAGENT_LLM_KEY=

# DeepSeek example (use your own key locally; never distribute .env):
# LABAGENT_LLM_URL=https://api.deepseek.com/chat/completions
# LABAGENT_LLM_MODEL=deepseek-flash
# Non-thinking tool protocol; enabled thinking is not supported by this adapter.
LABAGENT_LLM_THINKING=disabled
# Per HTTP request, 5..60 seconds. No automatic retries.
LABAGENT_LLM_TIMEOUT=45
# Per response, 128..2048 tokens; at most four teaching rounds.
LABAGENT_LLM_MAX_TOKENS=800
# Open investigation submits structured hypotheses, 256..2048 tokens per call.
LABAGENT_OPEN_MAX_TOKENS=1600

# Online deployment: Render supplies PORT and RENDER_EXTERNAL_URL automatically.
# Team username is labagent; set a shared password for the three testers.
# LABAGENT_TEAM_PASSWORD=
# LABAGENT_PUBLIC_URL=https://your-service.onrender.com
